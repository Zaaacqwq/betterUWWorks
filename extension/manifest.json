{
  "manifest_version": 3,
  "name": "betterUWWorks Scraper",
  "version": "0.3.0",
  "description": "Scrape job postings from WaterlooWorks",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://waterlooworks.uwaterloo.ca/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://ntfy.sh/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "betterUWWorks Scraper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://waterlooworks.uwaterloo.ca/*"
      ],
      "js": [
        "content/content.js",
        "content/open-posting.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
