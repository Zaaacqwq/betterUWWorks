<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily: opens Chrome so the extension's scrape runs, without anyone keeping
  Chrome open. The run itself is the extension's job (autorun.js) — this only
  launches Chrome. Keep the time below equal to the extension's daily run time
  (popup Settings, default 06:00). Installed by ops/bin/install-launchd.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.betteruwworks.scrape</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/bin/wake-and-scrape.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/betteruwworks/scrape.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/betteruwworks/scrape.log</string>
</dict>
</plist>
