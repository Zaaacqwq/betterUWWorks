<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dumps the database every night at 03:30, keeps two weeks of dumps, and
  copies each one off the machine when iCloud Drive is available.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.betteruwworks.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/web/scripts/db-backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>BACKUP_KEEP_DAYS</key>
    <string>14</string>
    <key>BACKUP_MIRROR_DIR</key>
    <string>__MIRROR__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/betteruwworks/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/betteruwworks/backup.log</string>
</dict>
</plist>
